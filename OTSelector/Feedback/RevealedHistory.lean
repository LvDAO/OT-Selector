import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.MeasureTheory.Function.StronglyMeasurable.Basic
import Mathlib.Probability.Process.Adapted
import Mathlib.Probability.Process.Filtration
import OTSelector.Feedback.StateMeasurable
import OTSelector.Feedback.RecursiveIntersectionBridge
import OTSelector.Feedback.NoTieNull
import OTSelector.Probability.UsualAugmentation

/-!
# The finite revealed history

This file records the finite post-jump state process and the raw filtration generated by the
information revealed by the feedback curve.  The sample space is kept unchanged.  In particular,
the no-tie event is not put into the raw snapshot; it is added only through the ambient-null
augmentation below.
-/

open MeasureTheory Set
open scoped Classical NNReal

namespace OTSelector

variable {n : ℕ}

namespace FiniteSample

variable (sample : FiniteSample n)

/-! ## Elapsed knots and the post-jump state -/

theorem feedbackKnot_ge_x0
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (m : ℕ) :
    x0 ≤ sample.feedbackKnot lam x0 p0 m := by
  have hmono := sample.feedbackState_x_mono hlam0 hlamHalf x0 p0
  simpa only [feedbackKnot_zero] using hmono (Nat.zero_le m)

noncomputable def elapsedFeedbackKnot
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (m : ℕ) : ℝ≥0 :=
  ⟨sample.feedbackKnot lam x0 p0 m - x0,
    sub_nonneg.mpr (sample.feedbackKnot_ge_x0 hlam0 hlamHalf x0 p0 m)⟩

@[simp]
theorem coe_elapsedFeedbackKnot
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (m : ℕ) :
    (sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m : ℝ) =
      sample.feedbackKnot lam x0 p0 m - x0 :=
  rfl

@[simp]
theorem elapsedFeedbackKnot_zero
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 0 = 0 := by
  apply NNReal.eq
  change sample.feedbackKnot lam x0 p0 0 - x0 = 0
  simp

theorem elapsedFeedbackKnot_mono
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    Monotone (sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0) := by
  intro m k hmk
  apply NNReal.coe_le_coe.mp
  simp only [coe_elapsedFeedbackKnot]
  linarith [sample.feedbackState_x_mono hlam0 hlamHalf x0 p0 hmk]

theorem measurable_elapsedFeedbackKnot
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (m : ℕ) :
    Measurable (fun sample : FiniteSample n ↦
      sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m) := by
  apply Measurable.subtype_mk
  change Measurable (fun sample : FiniteSample n ↦
    sample.feedbackKnot lam x0 p0 m - x0)
  exact (measurable_feedbackKnot (n := n) lam x0 p0 m).sub measurable_const

noncomputable def maxFinsetIndex {K : ℕ} (default : Fin K) (s : Finset (Fin K)) : Fin K :=
  if h : s.Nonempty then s.max' h else default

theorem maxFinsetIndex_mem {K : ℕ} (default : Fin K) {s : Finset (Fin K)} (hs : s.Nonempty) :
    maxFinsetIndex default s ∈ s := by
  rw [maxFinsetIndex, dite_eq_left hs]
  exact Finset.max'_mem s hs

theorem le_maxFinsetIndex {K : ℕ} (default : Fin K) {s : Finset (Fin K)} (hs : s.Nonempty)
    {i : Fin K} (hi : i ∈ s) :
    i ≤ maxFinsetIndex default s := by
  rw [maxFinsetIndex, dite_eq_left hs]
  exact Finset.le_max' s i hi

theorem maxFinsetIndex_le {K : ℕ} (default : Fin K) {s : Finset (Fin K)} (hs : s.Nonempty)
    {i : Fin K}
    (_hi : maxFinsetIndex default s ∈ s)
    (hle : ∀ j ∈ s, j ≤ i) :
    maxFinsetIndex default s ≤ i := by
  exact hle _ (maxFinsetIndex_mem default hs)

noncomputable def elapsedIndexSet
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) : Finset (Fin (2 * n + 1)) := by
  classical
  exact Finset.univ.filter fun m ↦
    sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m.val ≤ t

theorem zero_mem_elapsedIndexSet
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    (0 : Fin (2 * n + 1)) ∈ sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t := by
  simp [elapsedIndexSet, sample.elapsedFeedbackKnot_zero hlam0 hlamHalf x0 p0]

theorem measurableSet_mem_elapsedIndexSet
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) (m : Fin (2 * n + 1)) :
    MeasurableSet {sample : FiniteSample n |
      m ∈ sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t} := by
  simp only [elapsedIndexSet, Finset.mem_filter, Finset.mem_univ, true_and]
  exact measurableSet_le
    (measurable_elapsedFeedbackKnot (n := n) hlam0 hlamHalf x0 p0 m.val)
    measurable_const

theorem measurable_elapsedIndexSet
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    Measurable (fun sample : FiniteSample n ↦
      sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t) :=
  measurable_finset_of_mem fun m ↦
    measurableSet_mem_elapsedIndexSet (n := n) hlam0 hlamHalf x0 p0 t m

noncomputable def elapsedIndex
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) : Fin (2 * n + 1) :=
  maxFinsetIndex ⟨0, by omega⟩
    (sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t)

theorem elapsedIndex_mem
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    sample.elapsedIndex hlam0 hlamHalf x0 p0 t ∈
      sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t := by
  apply maxFinsetIndex_mem ⟨0, by omega⟩
  exact ⟨0, sample.zero_mem_elapsedIndexSet hlam0 hlamHalf x0 p0 t⟩

theorem measurable_elapsedIndex
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    Measurable (fun sample : FiniteSample n ↦
      sample.elapsedIndex hlam0 hlamHalf x0 p0 t) := by
  have hmax : Measurable (maxFinsetIndex ⟨0, by omega⟩ :
      Finset (Fin (2 * n + 1)) → Fin (2 * n + 1)) := measurable_of_countable _
  exact hmax.comp (measurable_elapsedIndexSet hlam0 hlamHalf x0 p0 t)

noncomputable def feedbackStateAtElapsed
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) : FeedbackStepState n :=
  feedbackState sample lam x0 p0
    (sample.elapsedIndex hlam0 hlamHalf x0 p0 t).val

theorem measurable_feedbackStateAtElapsed
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    Measurable (fun sample : FiniteSample n ↦
      sample.feedbackStateAtElapsed hlam0 hlamHalf x0 p0 t) := by
  have hidx := measurable_elapsedIndex (n := n) hlam0 hlamHalf x0 p0 t
  have heval : Measurable fun sample : FiniteSample n ↦
      feedbackState sample lam x0 p0
        ((sample.elapsedIndex hlam0 hlamHalf x0 p0 t).val) := by
    exact measurable_eval_countable
      (fun m : Fin (2 * n + 1) ↦ measurable_feedbackState lam x0 p0 m.val) hidx
  simpa [feedbackStateAtElapsed] using heval

theorem elapsedIndex_eq_of_mem_interval
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) {m : ℕ} (hm : m < 2 * n) {t : ℝ≥0}
    (hleft : sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m ≤ t)
    (hright : t < sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 (m + 1)) :
    (sample.elapsedIndex hlam0 hlamHalf x0 p0 t).val = m := by
  let I : Fin (2 * n + 1) := ⟨m, by omega⟩
  have hI_mem : I ∈ sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t := by
    simp only [elapsedIndexSet, Finset.mem_filter, Finset.mem_univ, true_and, I]
    exact hleft
  have hI_le : I ≤ sample.elapsedIndex hlam0 hlamHalf x0 p0 t := by
    exact le_maxFinsetIndex ⟨0, by omega⟩
      ⟨0, sample.zero_mem_elapsedIndexSet hlam0 hlamHalf x0 p0 t⟩ hI_mem
  have hidx_mem := sample.elapsedIndex_mem hlam0 hlamHalf x0 p0 t
  have hidx_le : sample.elapsedIndex hlam0 hlamHalf x0 p0 t ≤ I := by
    apply maxFinsetIndex_le ⟨0, by omega⟩
      (s := sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t)
      ⟨0, sample.zero_mem_elapsedIndexSet hlam0 hlamHalf x0 p0 t⟩ hidx_mem
    intro J hJ
    by_contra hnot
    have hIJ : I < J := lt_of_not_ge hnot
    have hm_lt : m + 1 ≤ J.val := by
      have hIJval : I.val < J.val := hIJ
      dsimp [I] at hIJval
      omega
    have hmono := sample.elapsedFeedbackKnot_mono hlam0 hlamHalf x0 p0 hm_lt
    have hJ_le := hJ
    simp only [elapsedIndexSet, Finset.mem_filter, Finset.mem_univ, true_and] at hJ_le
    have : sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 (m + 1) ≤ t :=
      hmono.trans hJ_le
    exact (not_le_of_gt hright) this
  have hEq : sample.elapsedIndex hlam0 hlamHalf x0 p0 t = I :=
    le_antisymm hidx_le hI_le
  have hEqVal := congrArg Fin.val hEq
  simpa [I] using hEqVal

theorem feedbackStateAtElapsed_eq_of_mem_interval
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) {m : ℕ} (hm : m < 2 * n) {t : ℝ≥0}
    (hleft : sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m ≤ t)
    (hright : t < sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 (m + 1)) :
    sample.feedbackStateAtElapsed hlam0 hlamHalf x0 p0 t =
      feedbackState sample lam x0 p0 m := by
  rw [feedbackStateAtElapsed]
  have hidx := sample.elapsedIndex_eq_of_mem_interval hlam0 hlamHalf x0 p0 hm hleft hright
  congr 1

theorem feedbackState_succ_eq_of_feedbackKnot_eq
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (m : ℕ)
    (heq : sample.feedbackKnot lam x0 p0 m =
      sample.feedbackKnot lam x0 p0 (m + 1)) :
    feedbackState sample lam x0 p0 (m + 1) =
      feedbackState sample lam x0 p0 m := by
  have hncand : ¬((feedbackState sample lam x0 p0 m).candidates sample lam).Nonempty := by
    intro hcand
    have hlt := sample.feedbackState_x_strictMono_step hlam0 hlamHalf x0 p0 m hcand
    exact (ne_of_lt hlt) heq
  exact sample.feedbackState_succ_eq_of_candidates_eq_empty lam x0 p0 m
    (Finset.not_nonempty_iff_eq_empty.mp hncand)

theorem feedbackState_eq_of_feedbackKnot_eq
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) {m r : ℕ} (hmr : m ≤ r)
    (heq : sample.feedbackKnot lam x0 p0 m =
      sample.feedbackKnot lam x0 p0 r) :
    feedbackState sample lam x0 p0 r =
      feedbackState sample lam x0 p0 m := by
  induction hmr with
  | refl => rfl
  | @step r hmr ih =>
      have hmono := sample.feedbackState_x_mono hlam0 hlamHalf x0 p0
      have hstep : sample.feedbackKnot lam x0 p0 r =
          sample.feedbackKnot lam x0 p0 (r + 1) := by
        apply le_antisymm
        · exact hmono (Nat.le_succ r)
        · rw [← heq]
          exact hmono hmr
      rw [sample.feedbackState_succ_eq_of_feedbackKnot_eq hlam0 hlamHalf x0 p0 r hstep]
      exact ih (heq.trans hstep.symm)

@[simp]
theorem feedbackStateAtElapsed_at_elapsedFeedbackKnot
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) {m : ℕ} (hm : m ≤ 2 * n) :
    sample.feedbackStateAtElapsed hlam0 hlamHalf x0 p0
        (sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m) =
      feedbackState sample lam x0 p0 m := by
  let t := sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m
  let J := sample.elapsedIndex hlam0 hlamHalf x0 p0 t
  have hm_mem : (⟨m, by omega⟩ : Fin (2 * n + 1)) ∈
      sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t := by
    simp only [elapsedIndexSet, Finset.mem_filter, Finset.mem_univ, true_and, t]
    exact le_rfl
  have hm_le : (⟨m, by omega⟩ : Fin (2 * n + 1)) ≤ J := by
    exact le_maxFinsetIndex ⟨0, by omega⟩
      ⟨0, sample.zero_mem_elapsedIndexSet hlam0 hlamHalf x0 p0 t⟩ hm_mem
  have hJ_mem := sample.elapsedIndex_mem hlam0 hlamHalf x0 p0 t
  have hJ_ge : m ≤ J.val := by
    have hval : (⟨m, by omega⟩ : Fin (2 * n + 1)).val ≤ J.val := hm_le
    exact hval
  have hJ_elapsed_le : sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 J.val ≤
      sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m := by
    have hK_le := hJ_mem
    simp only [elapsedIndexSet, Finset.mem_filter, Finset.mem_univ, true_and, t] at hK_le
    exact hK_le
  have hJ_knot_le : sample.feedbackKnot lam x0 p0 J.val ≤
      sample.feedbackKnot lam x0 p0 m := by
    have hcoe :
        (sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 J.val : ℝ) ≤
          (sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 m : ℝ) :=
      NNReal.coe_le_coe.mpr hJ_elapsed_le
    have hsub : sample.feedbackKnot lam x0 p0 J.val - x0 ≤
        sample.feedbackKnot lam x0 p0 m - x0 := by
      simpa only [coe_elapsedFeedbackKnot] using hcoe
    linarith
  have hmono := sample.feedbackState_x_mono hlam0 hlamHalf x0 p0 hJ_ge
  have hEqKnot : sample.feedbackKnot lam x0 p0 m =
      sample.feedbackKnot lam x0 p0 J.val := le_antisymm hmono hJ_knot_le
  rw [feedbackStateAtElapsed]
  rw [sample.feedbackState_eq_of_feedbackKnot_eq hlam0 hlamHalf x0 p0 hJ_ge hEqKnot]

theorem feedbackStateAtElapsed_eq_terminal_of_terminal_le
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) {t : ℝ≥0}
    (hterm : sample.elapsedFeedbackKnot hlam0 hlamHalf x0 p0 (2 * n) ≤ t) :
    sample.feedbackStateAtElapsed hlam0 hlamHalf x0 p0 t =
      feedbackState sample lam x0 p0 (2 * n) := by
  let H : Fin (2 * n + 1) := ⟨2 * n, by omega⟩
  have hH_mem : H ∈ sample.elapsedIndexSet hlam0 hlamHalf x0 p0 t := by
    simp only [elapsedIndexSet, Finset.mem_filter, Finset.mem_univ, true_and, H]
    exact hterm
  have hH_le : H ≤ sample.elapsedIndex hlam0 hlamHalf x0 p0 t := by
    exact le_maxFinsetIndex ⟨0, by omega⟩
      ⟨0, sample.zero_mem_elapsedIndexSet hlam0 hlamHalf x0 p0 t⟩ hH_mem
  have hidx_le : (sample.elapsedIndex hlam0 hlamHalf x0 p0 t).val ≤ 2 * n :=
    by
      have hlt := (sample.elapsedIndex hlam0 hlamHalf x0 p0 t).isLt
      omega
  have hidx_ge : 2 * n ≤
      (sample.elapsedIndex hlam0 hlamHalf x0 p0 t).val := hH_le
  have hidx_eq : (sample.elapsedIndex hlam0 hlamHalf x0 p0 t).val = 2 * n :=
    le_antisymm hidx_le hidx_ge
  rw [feedbackStateAtElapsed]
  congr 1

/-! ## Masked revealed coordinates -/

/-- A revealed coordinate carries an explicit visibility bit and its actual marked point.

The `false` branch is filled with `defaultPoint`; no `Option`-valued coordinate is used in the raw
snapshot, so the construction only needs the ordinary Borel instances on finite products.
-/
abbrev MaskedMarkedHeight := Bool × MarkedHeight

/- Finsets of `Fin n` are finite discrete coordinates.  The measurable structure supplied by
`Finset.instMeasurableSpace` is the full finite sigma-algebra, so the bottom topology gives the
standard Borel structure needed by `Filtration.natural`. -/
noncomputable instance instTopologicalSpaceFinset : TopologicalSpace (Finset (Fin n)) := ⊥

noncomputable instance instDiscreteTopologyFinset : DiscreteTopology (Finset (Fin n)) :=
  discreteTopology_bot _

noncomputable instance instBorelSpaceFinset : BorelSpace (Finset (Fin n)) := by
  constructor
  rw [borel_eq_top_of_discrete]
  apply le_antisymm le_top
  intro s _
  exact Set.Finite.measurableSet (Set.toFinite s)

def defaultPoint : MarkedHeight := ((0 : UnitMark), (0 : UnitMark))

noncomputable def maskedSourcePoint (sample : FiniteSample n)
    (state : FeedbackStepState n) (i : Fin n) : MaskedMarkedHeight :=
  if i ∈ state.seenSource then (true, sample.sourcePoint i) else (false, defaultPoint)

noncomputable def maskedTargetPoint (sample : FiniteSample n)
    (state : FeedbackStepState n) (j : Fin n) : MaskedMarkedHeight :=
  if j ∈ state.seenTarget then (true, sample.targetPoint j) else (false, defaultPoint)

noncomputable def maskedSourceArray (sample : FiniteSample n)
    (state : FeedbackStepState n) : Fin n → MaskedMarkedHeight :=
  fun i ↦ maskedSourcePoint sample state i

noncomputable def maskedTargetArray (sample : FiniteSample n)
    (state : FeedbackStepState n) : Fin n → MaskedMarkedHeight :=
  fun j ↦ maskedTargetPoint sample state j

abbrev RevealedSnapshot (n : ℕ) :=
  (ℝ × ℝ × ℤ × Finset (Fin n) × Finset (Fin n)) ×
    ((Fin n → MaskedMarkedHeight) × (Fin n → MaskedMarkedHeight))

noncomputable instance instOpensMeasurableMaskedArrayPair :
    OpensMeasurableSpace
      ((Fin n → MaskedMarkedHeight) × (Fin n → MaskedMarkedHeight)) := by
  let : SecondCountableTopologyEither
      (Fin n → MaskedMarkedHeight) (Fin n → MaskedMarkedHeight) :=
    secondCountableTopologyEither_of_left _ _
  infer_instance

noncomputable instance instBorelSpaceMaskedArrayPair :
    BorelSpace
      ((Fin n → MaskedMarkedHeight) × (Fin n → MaskedMarkedHeight)) := by
  exact ⟨le_antisymm prod_le_borel_prod OpensMeasurableSpace.borel_le⟩

noncomputable instance instOpensMeasurableRevealedSnapshot :
    OpensMeasurableSpace (RevealedSnapshot n) := by
  let : SecondCountableTopologyEither
      (ℝ × ℝ × ℤ × Finset (Fin n) × Finset (Fin n))
      ((Fin n → MaskedMarkedHeight) × (Fin n → MaskedMarkedHeight)) :=
    secondCountableTopologyEither_of_left _ _
  infer_instance

noncomputable instance instBorelSpaceRevealedSnapshot :
    BorelSpace (RevealedSnapshot n) := by
  exact ⟨le_antisymm prod_le_borel_prod OpensMeasurableSpace.borel_le⟩

noncomputable def revealedSnapshotFromState (sample : FiniteSample n)
    (state : FeedbackStepState n) : RevealedSnapshot n :=
  (FeedbackStepState.pack state,
    (maskedSourceArray sample state, maskedTargetArray sample state))

theorem measurable_sourcePoint (i : Fin n) :
    Measurable (fun sample : FiniteSample n ↦ sample.sourcePoint i) :=
  (measurable_sourceHeight i).prodMk (measurable_sourceMark i)

theorem measurable_targetPoint (j : Fin n) :
    Measurable (fun sample : FiniteSample n ↦ sample.targetPoint j) :=
  (measurable_targetHeight j).prodMk (measurable_targetMark j)

theorem measurable_maskedSourcePoint (i : Fin n) :
    Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      maskedSourcePoint p.1 p.2 i) := by
  have hseen : MeasurableSet {p : FiniteSample n × FeedbackStepState n | i ∈ p.2.seenSource} :=
    measurableSet_mem_seenSource i
  have hpoint : Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      p.1.sourcePoint i) :=
    (measurable_sourcePoint i).comp measurable_fst
  have htrue : Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      (true, p.1.sourcePoint i)) := measurable_const.prodMk hpoint
  have hfalse : Measurable (fun _p : FiniteSample n × FeedbackStepState n ↦
      (false, defaultPoint)) := measurable_const
  simpa [maskedSourcePoint] using Measurable.ite hseen htrue hfalse

theorem measurable_maskedTargetPoint (j : Fin n) :
    Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      maskedTargetPoint p.1 p.2 j) := by
  have hseen : MeasurableSet {p : FiniteSample n × FeedbackStepState n | j ∈ p.2.seenTarget} :=
    measurableSet_mem_seenTarget j
  have hpoint : Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      p.1.targetPoint j) :=
    (measurable_targetPoint j).comp measurable_fst
  have htrue : Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      (true, p.1.targetPoint j)) := measurable_const.prodMk hpoint
  have hfalse : Measurable (fun _p : FiniteSample n × FeedbackStepState n ↦
      (false, defaultPoint)) := measurable_const
  simpa [maskedTargetPoint] using Measurable.ite hseen htrue hfalse

theorem measurable_maskedSourceArray :
    Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      maskedSourceArray p.1 p.2) :=
  measurable_pi_lambda _ fun i ↦ measurable_maskedSourcePoint i

theorem measurable_maskedTargetArray :
    Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      maskedTargetArray p.1 p.2) :=
  measurable_pi_lambda _ fun j ↦ measurable_maskedTargetPoint j

theorem stronglyMeasurable_maskedSourceArray :
    StronglyMeasurable (fun p : FiniteSample n × FeedbackStepState n ↦
      maskedSourceArray p.1 p.2) :=
  measurable_maskedSourceArray.stronglyMeasurable

theorem stronglyMeasurable_maskedTargetArray :
    StronglyMeasurable (fun p : FiniteSample n × FeedbackStepState n ↦
      maskedTargetArray p.1 p.2) :=
  measurable_maskedTargetArray.stronglyMeasurable

theorem measurable_revealedSnapshotFromState :
    Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      revealedSnapshotFromState p.1 p.2) := by
  have hpack : Measurable (fun p : FiniteSample n × FeedbackStepState n ↦
      FeedbackStepState.pack p.2) := FeedbackStepState.measurable_pack.comp measurable_snd
  exact hpack.prodMk (measurable_maskedSourceArray.prodMk measurable_maskedTargetArray)

theorem stronglyMeasurable_revealedSnapshotFromState :
    StronglyMeasurable (fun p : FiniteSample n × FeedbackStepState n ↦
      revealedSnapshotFromState p.1 p.2) :=
  measurable_revealedSnapshotFromState.stronglyMeasurable

noncomputable def revealedSnapshotAtElapsed
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) : RevealedSnapshot n :=
  revealedSnapshotFromState sample
    (sample.feedbackStateAtElapsed hlam0 hlamHalf x0 p0 t)

theorem measurable_revealedSnapshotAtElapsed
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    Measurable (fun sample : FiniteSample n ↦
      sample.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 t) := by
  have hstate := measurable_feedbackStateAtElapsed (n := n) hlam0 hlamHalf x0 p0 t
  have hpair : Measurable (fun sample : FiniteSample n ↦
      (sample, sample.feedbackStateAtElapsed hlam0 hlamHalf x0 p0 t)) :=
    measurable_id.prodMk hstate
  exact measurable_revealedSnapshotFromState.comp hpair

theorem stronglyMeasurable_revealedSnapshotAtElapsed
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) (t : ℝ≥0) :
    StronglyMeasurable (fun sample : FiniteSample n ↦
      sample.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 t) :=
  (measurable_revealedSnapshotAtElapsed (n := n) hlam0 hlamHalf x0 p0 t).stronglyMeasurable

/-! ## Raw and usual revealed filtrations -/

noncomputable def rawRevealedFiltration
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (FiniteSample n)) :=
  Filtration.natural
    (fun t sample ↦ sample.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 t)
    (fun t ↦ stronglyMeasurable_revealedSnapshotAtElapsed
      (n := n) hlam0 hlamHalf x0 p0 t)

noncomputable def usualRevealedFiltration
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (FiniteSample n)) :=
  usualAugmentation (rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0)
    (finiteSampleLaw n : Measure (FiniteSample n))

theorem stronglyAdapted_rawRevealedSnapshot
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    StronglyAdapted
      (rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0)
      (fun t sample ↦ sample.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 t) := by
  apply Filtration.stronglyAdapted_natural

theorem rawRevealedFiltration_le_usual
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0 ≤
      usualRevealedFiltration (n := n) hlam0 hlamHalf x0 p0 :=
  le_usualAugmentation (rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0)
    (finiteSampleLaw n : Measure (FiniteSample n))

theorem usualRevealedFiltration_isRightContinuous
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    Filtration.IsRightContinuous
      (usualRevealedFiltration (n := n) hlam0 hlamHalf x0 p0) :=
  usualAugmentation_isRightContinuous
    (rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0)
    (finiteSampleLaw n : Measure (FiniteSample n))

/-! ## The terminal-null tie event at time zero -/

def feedbackTieEvent (lam x0 p0 : ℝ) : Set (FiniteSample n) :=
  {sample | ¬sample.NoFeedbackTies lam x0 p0}

def feedbackGoodEvent (lam x0 p0 : ℝ) : Set (FiniteSample n) :=
  {sample | sample.NoFeedbackTies lam x0 p0}

theorem measurableSet_feedbackTieEvent_ambient (lam x0 p0 : ℝ) :
    MeasurableSet (feedbackTieEvent (n := n) lam x0 p0) := by
  simpa [feedbackTieEvent] using
    (measurableSet_feedbackTieEvent (n := n) lam x0 p0)

theorem feedbackTieEvent_measure_zero
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    (finiteSampleLaw n : Measure (FiniteSample n))
      (feedbackTieEvent (n := n) lam x0 p0) = 0 := by
  simpa [feedbackTieEvent] using
    (measure_feedbackTieEvent_eq_zero (n := n) (x0 := x0) (p0 := p0)
      hlam0 hlamHalf)

theorem measurableSet_feedbackTieEvent_usual_zero
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    MeasurableSet[
      usualRevealedFiltration (n := n) hlam0 hlamHalf x0 p0 0]
        (feedbackTieEvent (n := n) lam x0 p0) := by
  exact usualAugmentation_measurableSet_null_bot
    (rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0)
    (finiteSampleLaw n : Measure (FiniteSample n))
    (measurableSet_feedbackTieEvent_ambient (n := n) lam x0 p0)
    (feedbackTieEvent_measure_zero (n := n) hlam0 hlamHalf x0 p0)

theorem measurableSet_feedbackGoodEvent_usual_zero
    {lam : ℝ} (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2)
    (x0 p0 : ℝ) :
    MeasurableSet[
      usualRevealedFiltration (n := n) hlam0 hlamHalf x0 p0 0]
        (feedbackGoodEvent (n := n) lam x0 p0) := by
  have htie := measurableSet_feedbackTieEvent_usual_zero
    (n := n) hlam0 hlamHalf x0 p0
  have hcomp : feedbackGoodEvent (n := n) lam x0 p0 =
      (feedbackTieEvent (n := n) lam x0 p0)ᶜ := by
    ext sample
    simp [feedbackGoodEvent, feedbackTieEvent]
  rw [hcomp]
  exact htie.compl

end FiniteSample

end OTSelector
