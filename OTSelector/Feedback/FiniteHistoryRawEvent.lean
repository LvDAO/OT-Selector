import OTSelector.Feedback.FiniteHistoryPathSection
import OTSelector.Feedback.FiniteHistoryProductSection
import OTSelector.Feedback.RevealedHistory

/-!
# Raw revealed events on a finite-history cell

The raw filtration is generated by the whole revealed-snapshot path up to the elapsed
observation time.  The path factorization on a fixed history cell therefore implies that every
raw measurable event has constant membership on the section with fixed terminal seen tuple.

This file records only that deterministic factorization.  It does not assert anything about the
usual augmentation, compensators, or intensities.
-/

open MeasureTheory Set
open scoped Classical NNReal

namespace OTSelector

variable {n : ℕ}

/-! ## Raw-event membership -/

/-- A raw revealed event at the elapsed coordinate `x - x0` cannot distinguish two samples in
the same history cell once their terminal seen tuples agree. -/
theorem rawRevealedEvent_mem_iff_of_historyAtCoordinate
    (reference sample : FiniteSample n) {lam x0 p0 x : ℝ}
    (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2) (hx0x : x0 ≤ x)
    {sourcePattern targetPattern : Finset (Fin n)}
    {history : List (FeedbackLabel n)}
    (href : HistoryAtCoordinate reference lam x0 p0 sourcePattern targetPattern history x)
    (hsample : HistoryAtCoordinate sample lam x0 p0 sourcePattern targetPattern history x)
    (htuple :
      feedbackSeenTuple (feedbackTerminalLabelSet sourcePattern targetPattern history) reference =
        feedbackSeenTuple
          (feedbackTerminalLabelSet sourcePattern targetPattern history) sample)
    (B : Set (FiniteSample n))
    (hB : MeasurableSet[
      FiniteSample.rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0
        ⟨x - x0, sub_nonneg.mpr hx0x⟩] B) :
    reference ∈ B ↔ sample ∈ B := by
  let t : ℝ≥0 := ⟨x - x0, sub_nonneg.mpr hx0x⟩
  have hBraw : MeasurableSet[
      (FiniteSample.rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0 t :
        MeasurableSpace (FiniteSample n))] B := by
    simpa [t] using hB
  rw [FiniteSample.rawRevealedFiltration, Filtration.natural_eq_comap] at hBraw
  obtain ⟨A, hA, hpre⟩ :=
    (MeasurableSpace.measurableSet_comap.mp hBraw)
  have hpath :
      (fun u : Set.Iic t ↦
        reference.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 u.1) =
      (fun u : Set.Iic t ↦
        sample.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 u.1) := by
    exact revealedSnapshotAtElapsed_path_eq_of_historyAtCoordinate reference sample
      hlam0 hlamHalf hx0x href hsample htuple
  rw [← hpre]
  change
    (fun u : Set.Iic t ↦
        reference.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 u.1) ∈ A ↔
      (fun u : Set.Iic t ↦
        sample.revealedSnapshotAtElapsed hlam0 hlamHalf x0 p0 u.1) ∈ A
  rw [hpath]

/-! ## Product-coordinate sections -/

/-- On a fixed timed-history section, a raw past event is either the whole unseen rectangle or
the empty set.  Which alternative occurs is decided by the fixed seen tuple represented by
`reference`.

The statement keeps the continuously valued seen tuple as an integration parameter; it does not
treat that tuple as a positive-probability filtration atom. -/
theorem rawRevealedEvent_historySection_eq
    (reference : FiniteSample n) {lam x0 p0 x : ℝ}
    (hlam0 : 0 ≤ lam) (hlamHalf : lam < 1 / 2) (hx0x : x0 ≤ x)
    {sourcePattern targetPattern : Finset (Fin n)}
    {history : List (FeedbackLabel n)}
    (href : HistoryAtCoordinate reference lam x0 p0 sourcePattern targetPattern history x)
    (B : Set (FiniteSample n))
    (hB : MeasurableSet[
      FiniteSample.rawRevealedFiltration (n := n) hlam0 hlamHalf x0 p0
        ⟨x - x0, sub_nonneg.mpr hx0x⟩] B) :
    let S := feedbackTerminalLabelSet sourcePattern targetPattern history
    let terminal := reference.scheduledState lam x0 p0 sourcePattern targetPattern history
    {unseen : feedbackUnseenFinset S → MarkedHeight |
        HistoryAtCoordinate
            (finiteSampleSeenUnseenMerge S (feedbackSeenTuple S reference) unseen)
            lam x0 p0 sourcePattern targetPattern history x ∧
          finiteSampleSeenUnseenMerge S (feedbackSeenTuple S reference) unseen ∈ B} =
      if reference ∈ B then
        feedbackUnseenRectangularSetAt lam terminal x S
      else ∅ := by
  classical
  let S := feedbackTerminalLabelSet sourcePattern targetPattern history
  let terminal := reference.scheduledState lam x0 p0 sourcePattern targetPattern history
  dsimp only
  ext unseen
  let sample := finiteSampleSeenUnseenMerge S (feedbackSeenTuple S reference) unseen
  change
    (HistoryAtCoordinate sample lam x0 p0 sourcePattern targetPattern history x ∧
        sample ∈ B) ↔
      unseen ∈
        if reference ∈ B then
          feedbackUnseenRectangularSetAt lam terminal x S
        else ∅
  have hcell_iff :
      HistoryAtCoordinate sample lam x0 p0 sourcePattern targetPattern history x ↔
        unseen ∈ feedbackUnseenRectangularSetAt lam terminal x S := by
    dsimp [sample, S, terminal]
    exact historyAtCoordinate_finiteSampleSeenUnseenMerge_iff reference
      hlam0 hlamHalf href _ _ rfl
  by_cases hcell :
      HistoryAtCoordinate sample lam x0 p0 sourcePattern targetPattern history x
  · have htuple : feedbackSeenTuple S reference = feedbackSeenTuple S sample := by
      dsimp [sample]
      rw [feedbackSeenTuple_finiteSampleSeenUnseenMerge]
    have hmem := rawRevealedEvent_mem_iff_of_historyAtCoordinate
      reference sample hlam0 hlamHalf hx0x href hcell htuple B hB
    have hrectangle : unseen ∈ feedbackUnseenRectangularSetAt lam terminal x S :=
      hcell_iff.mp hcell
    by_cases hrefB : reference ∈ B
    · have hsampleB : sample ∈ B := hmem.mp hrefB
      rw [ite_eq_left hrefB]
      exact iff_of_true ⟨hcell, hsampleB⟩ hrectangle
    · have hsampleB : sample ∉ B := by
        intro hs
        exact hrefB (hmem.mpr hs)
      rw [ite_eq_right hrefB]
      exact iff_of_false (fun hs ↦ hsampleB hs.2) (by simp)
  · have hrectangle : unseen ∉ feedbackUnseenRectangularSetAt lam terminal x S := by
      intro hu
      exact hcell (hcell_iff.mpr hu)
    by_cases hrefB : reference ∈ B
    · rw [ite_eq_left hrefB]
      exact iff_of_false (fun hs ↦ hcell hs.1) hrectangle
    · rw [ite_eq_right hrefB]
      exact iff_of_false (fun hs ↦ hcell hs.1) (by simp)

end OTSelector
