import OTSelector.PointProcess.Configuration
import Mathlib.Topology.ContinuousMap.CompactlySupported
import Mathlib.Topology.Homeomorph.Lemmas

/-!
# Test-function topology on locally finite configurations

This file equips marked configurations with the initial topology generated by integration against
compactly supported continuous real-valued test functions.  Each integral is an actual finite sum:
local finiteness of the configuration and compactness of the test-function support prove the
required finiteness.

The construction below proves continuity of every test integral and of translation by each fixed
real displacement.  It deliberately does not assert that the topology is Hausdorff, metrizable,
second countable, or standard Borel.  Such separation and countability results require additional
hypotheses on the mark space and a proved countable separating family of test functions.
-/

open Function Set
open scoped BigOperators CompactlySupported

namespace OTSelector.PointProcess

namespace Configuration

variable {M : Type*} [TopologicalSpace M]

/-- The summand obtained by integrating a compactly supported test function against a marked
configuration, including the natural multiplicity stored at each site. -/
def testSummand (config : Configuration M) (f : C_c(RealMarkedPoint M, ℝ))
    (z : RealMarkedPoint M) : ℝ :=
  (config z : ℝ) * f z

/-- The summand of a compactly supported test function has finite support.  This is the precise
finiteness input behind `testIntegral`; it follows from local finiteness rather than from an
additional interface assumption. -/
theorem support_testSummand_subset (config : Configuration M)
    (f : C_c(RealMarkedPoint M, ℝ)) :
    support (testSummand config f) ⊆ tsupport f ∩ config.support := by
  intro z hz
  constructor
  · apply subset_tsupport
    intro hfz
    exact hz (by simp [testSummand, hfz])
  · intro hcz
    exact hz (by simp [testSummand, hcz])

/-- The support of a test summand is finite. -/
theorem finite_support_testSummand (config : Configuration M)
    (f : C_c(RealMarkedPoint M, ℝ)) : (support (testSummand config f)).Finite := by
  refine (config.finite_support_inter_compact f.hasCompactSupport).subset ?_
  exact support_testSummand_subset config f

/-- Integral of a compactly supported continuous test function against a configuration.  The
`finsum` is finite by `finite_support_testSummand`. -/
noncomputable def testIntegral (config : Configuration M)
    (f : C_c(RealMarkedPoint M, ℝ)) : ℝ :=
  ∑ᶠ z, testSummand config f z

/-- The test integral is the ordinary sum over the finite support of its summand. -/
theorem testIntegral_eq_sum_support (config : Configuration M)
    (f : C_c(RealMarkedPoint M, ℝ)) :
    testIntegral config f =
      ∑ z ∈ (finite_support_testSummand config f).toFinset, testSummand config f z := by
  exact finsum_eq_sum _ (finite_support_testSummand config f)

/-- The test integral is also the sum over the compact test support intersected with the
configuration support.  Terms that vanish inside this finite window do not affect the sum. -/
theorem testIntegral_eq_sum_tsupport_inter_support (config : Configuration M)
    (f : C_c(RealMarkedPoint M, ℝ)) :
    testIntegral config f =
      ∑ z ∈ (config.finite_support_inter_compact f.hasCompactSupport).toFinset,
        testSummand config f z := by
  apply finsum_eq_sum_of_support_subset
  intro z hz
  exact (config.finite_support_inter_compact f.hasCompactSupport).mem_toFinset.mpr
    (support_testSummand_subset config f hz)

/-- The initial topology generated by all compactly supported continuous test integrals. -/
@[instance_reducible]
noncomputable def vagueTopology : TopologicalSpace (Configuration M) :=
  ⨅ f : C_c(RealMarkedPoint M, ℝ),
    TopologicalSpace.induced (fun config ↦ testIntegral config f) inferInstance

noncomputable instance instTopologicalSpace : TopologicalSpace (Configuration M) :=
  vagueTopology

/-- Every compactly supported test integral is continuous by construction of the initial
topology. -/
theorem continuous_testIntegral (f : C_c(RealMarkedPoint M, ℝ)) :
    Continuous fun config : Configuration M ↦ testIntegral config f := by
  apply continuous_iInf_dom (i := f)
  exact continuous_induced_dom

/-- Pull a test function back along translation of the underlying marked point. -/
def translateTest (a : ℝ) (f : C_c(RealMarkedPoint M, ℝ)) :
    C_c(RealMarkedPoint M, ℝ) :=
  f.comp (pointTranslation a).toCocompactMap

@[simp]
theorem translateTest_apply (a : ℝ) (f : C_c(RealMarkedPoint M, ℝ))
    (z : RealMarkedPoint M) : translateTest a f z = f (z.1 + a, z.2) :=
  rfl

@[simp]
theorem translateTest_zero (f : C_c(RealMarkedPoint M, ℝ)) : translateTest 0 f = f := by
  ext z
  simp

/-- Pullback of tests respects addition of translation displacements. -/
theorem translateTest_add (a b : ℝ) (f : C_c(RealMarkedPoint M, ℝ)) :
    translateTest (a + b) f = translateTest b (translateTest a f) := by
  ext z
  simp only [translateTest_apply]
  congr 2
  ring

/-- Translating a configuration transfers to pulling back its test function. -/
theorem testIntegral_translate (a : ℝ) (config : Configuration M)
    (f : C_c(RealMarkedPoint M, ℝ)) :
    testIntegral (translate a config) f = testIntegral config (translateTest a f) := by
  unfold testIntegral
  symm
  apply finsum_eq_of_bijective (pointTranslation a) (pointTranslation a).bijective
  intro z
  simp [testSummand]

/-- Translation by a fixed displacement is continuous for the test-function topology. -/
theorem continuous_translate (a : ℝ) :
    Continuous fun config : Configuration M ↦ translate a config := by
  rw [show instTopologicalSpace =
    ⨅ f : C_c(RealMarkedPoint M, ℝ),
      TopologicalSpace.induced (fun config ↦ testIntegral config f) inferInstance from rfl]
  rw [continuous_iInf_rng]
  intro f
  rw [continuous_induced_rng]
  simpa only [Function.comp_def, testIntegral_translate] using
    continuous_testIntegral (translateTest a f)

end Configuration

end OTSelector.PointProcess
