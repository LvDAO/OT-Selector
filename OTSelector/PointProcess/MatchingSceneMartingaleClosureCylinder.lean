import OTSelector.PointProcess.MatchingSceneMartingaleObservable
import Mathlib.MeasureTheory.Constructions.Projective
import Mathlib.MeasureTheory.Measure.HasOuterApproxClosed
import Mathlib.MeasureTheory.Integral.Bochner.ContinuousLinearMap

/-!
# From finite continuous cylinders to all observed events

A residual is tested against finite continuous functions of the actual observations. Equality
of its positive weighted laws gives zero integral on the entire observed sigma algebra. The
argument uses uniqueness of finite-dimensional laws, with no countability assumption on the
observation index and no topological assumption on the sample space.
-/

open MeasureTheory Set Filter
open scoped ENNReal BoundedContinuousFunction

set_option maxHeartbeats 600000

namespace OTSelector.Probability

variable {Ω I : Type*} [MeasurableSpace Ω]

private theorem integral_map_density (μ : Measure Ω) {f : Ω → ℝ}
    (hf : Measurable f) (hn : ∀ ω, 0 ≤ f ω)
    {Y : Type*} [MeasurableSpace Y] {X : Ω → Y} (hX : Measurable X)
    {g : Y → ℝ} (hg : StronglyMeasurable g) :
    (∫ y, g y ∂(μ.withDensity (fun ω ↦ ENNReal.ofReal (f ω))).map X) =
      ∫ ω, f ω * g (X ω) ∂μ := by
  rw [integral_map_of_stronglyMeasurable hX hg,
    integral_withDensity_eq_integral_toReal_smul hf.ennreal_ofReal
      (Eventually.of_forall fun _ ↦ ENNReal.ofReal_lt_top)]
  simp only [ENNReal.toReal_ofReal (hn _), smul_eq_mul]

/-- Bounded continuous tests of every finite observed vector determine the weighted law of
all observations, including when the observation index is uncountable. -/
theorem map_withDensity_eq_of_finite_continuous_cylinders
    (μ : Measure Ω) (X : Ω → I → ℝ) (hX : Measurable X)
    {f g : Ω → ℝ} (hf : Measurable f) (hg : Measurable g)
    (hfi : Integrable f μ) (hgi : Integrable g μ)
    (hfn : ∀ ω, 0 ≤ f ω) (hgn : ∀ ω, 0 ≤ g ω)
    (h : ∀ (J : Finset I) (F : (J → ℝ) →ᵇ ℝ),
      (∫ ω, f ω * F (J.restrict (X ω)) ∂μ) =
        ∫ ω, g ω * F (J.restrict (X ω)) ∂μ) :
    (μ.withDensity (fun ω ↦ ENNReal.ofReal (f ω))).map X =
      (μ.withDensity (fun ω ↦ ENNReal.ofReal (g ω))).map X := by
  let := isFiniteMeasure_withDensity_ofReal hfi.hasFiniteIntegral
  let := isFiniteMeasure_withDensity_ofReal hgi.hasFiniteIntegral
  apply IsProjectiveLimit.unique
    (P := fun J ↦ ((μ.withDensity (fun ω ↦ ENNReal.ofReal (f ω))).map X).map J.restrict)
    (fun _ ↦ rfl)
  intro J
  dsimp only
  rw [Measure.map_map J.measurable_restrict hX,
    Measure.map_map J.measurable_restrict hX]
  apply ext_of_forall_integral_eq_of_IsFiniteMeasure
  intro F
  rw [integral_map_density μ hg hgn (J.measurable_restrict.comp hX) F.continuous.measurable.stronglyMeasurable,
    integral_map_density μ hf hfn (J.measurable_restrict.comp hX) F.continuous.measurable.stronglyMeasurable]
  exact (h J F).symm

/-- Vanishing finite continuous cylinder residuals imply the defining zero-integral identity
for every event in the sigma algebra generated by the observations. -/
theorem setIntegral_eq_zero_of_finite_continuous_cylinders
    (μ : Measure Ω) (X : Ω → I → ℝ) (hX : Measurable X)
    {R : Ω → ℝ} (hRm : Measurable R) (hRi : Integrable R μ)
    (h : ∀ (J : Finset I) (F : (J → ℝ) →ᵇ ℝ),
      (∫ ω, R ω * F (J.restrict (X ω)) ∂μ) = 0)
    {A : Set Ω} (hA : MeasurableSet[MeasurableSpace.comap X inferInstance] A) :
    ∫ ω in A, R ω ∂μ = 0 := by
  let f : Ω → ℝ := fun ω ↦ |R ω| + R ω
  let g : Ω → ℝ := fun ω ↦ |R ω|
  have hf : Measurable f := hRm.abs.add hRm
  have hg : Measurable g := hRm.abs
  have hfi : Integrable f μ := hRi.abs.add hRi
  have hgi : Integrable g μ := hRi.abs
  have hfn (ω) : 0 ≤ f ω := by dsimp [f]; linarith [neg_abs_le (R ω)]
  have hgn (ω) : 0 ≤ g ω := abs_nonneg _
  have heq := map_withDensity_eq_of_finite_continuous_cylinders μ X hX hf hg hfi hgi
    hfn hgn (fun J F ↦ by
      have hm : AEStronglyMeasurable (fun ω ↦ F (J.restrict (X ω))) μ :=
        (F.continuous.measurable.comp (J.measurable_restrict.comp hX)).aestronglyMeasurable
      have hb : ∀ᵐ ω ∂μ, ‖F (J.restrict (X ω))‖ ≤ ‖F‖ :=
        Eventually.of_forall fun _ ↦ F.norm_coe_le_norm _
      dsimp [f, g]
      simp_rw [add_mul]
      rw [integral_add (hRi.abs.mul_bdd hm hb) (hRi.mul_bdd hm hb), h J F, add_zero])
  obtain ⟨B, hB, rfl⟩ := hA
  have hB' : StronglyMeasurable (B.indicator (fun _ : I → ℝ ↦ (1 : ℝ))) :=
    stronglyMeasurable_const.indicator hB
  have hh := congrArg (fun ν : Measure (I → ℝ) ↦
    ∫ x, B.indicator (fun _ ↦ (1 : ℝ)) x ∂ν) heq
  rw [integral_map_density μ hf hfn hX hB', integral_map_density μ hg hgn hX hB'] at hh
  have hid (w : Ω → ℝ) :
      (fun ω ↦ w ω * B.indicator (fun _ ↦ (1 : ℝ)) (X ω)) =
        (X ⁻¹' B).indicator w := by
    funext ω
    by_cases hw : X ω ∈ B <;> simp [hw]
  rw [hid f, hid g, integral_indicator (hX hB), integral_indicator (hX hB)] at hh
  dsimp [f, g] at hh
  rw [integral_add hRi.abs.integrableOn hRi.integrableOn] at hh
  linarith

/-- A genuine martingale follows from finite continuous past-cylinder residual identities.
The observation map must generate the chosen past sigma algebra; adaptedness and integrability
are separate elementary properties of the actual process, not martingale assumptions. -/
theorem martingale_of_finite_continuous_cylinder_residuals
    {T : Type*} [Preorder T] (μ : Measure Ω) [IsFiniteMeasure μ]
    (ℱ : Filtration T ‹MeasurableSpace Ω›) (M : T → Ω → ℝ)
    (index : T → Type*) (X : ∀ s, Ω → index s → ℝ)
    (hX : ∀ s, Measurable (X s))
    (hgen : ∀ s, ℱ s = MeasurableSpace.comap (X s) inferInstance)
    (hadapt : StronglyAdapted ℱ M) (hi : ∀ t, Integrable (M t) μ)
    (hres : ∀ s t, s ≤ t → ∀ (J : Finset (index s)) (F : (J → ℝ) →ᵇ ℝ),
      (∫ ω, (M t ω - M s ω) * F (J.restrict (X s ω)) ∂μ) = 0) :
    Martingale M ℱ μ := by
  refine ⟨hadapt, fun s t hst ↦ ?_⟩
  apply EventuallyEq.symm
  apply ae_eq_condExp_of_forall_setIntegral_eq (ℱ.le s) (hi t)
    (fun _ _ _ ↦ (hi s).integrableOn) ?_ (hadapt s).aestronglyMeasurable
  intro A hA _
  have hz := setIntegral_eq_zero_of_finite_continuous_cylinders μ (X s) (hX s)
    (((hadapt t).measurable.mono (ℱ.le t) le_rfl).sub
      ((hadapt s).measurable.mono (ℱ.le s) le_rfl)) ((hi t).sub (hi s))
    (hres s t hst) (by rwa [← hgen s])
  change (∫ ω in A, M t ω - M s ω ∂μ) = 0 at hz
  rw [integral_sub (hi t).integrableOn (hi s).integrableOn] at hz
  exact (sub_eq_zero.mp hz).symm

end OTSelector.Probability
