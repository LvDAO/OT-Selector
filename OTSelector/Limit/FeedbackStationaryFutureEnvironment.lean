import OTSelector.Limit.FeedbackStationaryFutureHistory
import OTSelector.Limit.FeedbackStationaryFuturePoints

/-!
# The actual stationary environment's positive marked point-process law

The two actual counting measures on the positive half-line, jointly with the root current,
have the law obtained from the original marked trajectory kernel. This identifies physical
point observations of the bare environment, with multiplicities retained.
-/

open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal

namespace OTSelector.Limit

open PointProcess

attribute [local instance] Classical.propDecidable

/-- The marked point measure of all jumps in one direction along a complete forward path. -/
noncomputable def feedbackFutureDirectionMeasure (direction : ℤ) (w : FeedbackCellPath) :
    Measure MatchingPoint :=
  Measure.sum (fun m : ℕ ↦ if feedbackCellJump w m = direction then
    Measure.dirac (feedbackCellClock w (m + 1), (w (m + 1)).2.1) else 0)

theorem measurable_feedbackFutureDirectionMeasure (direction : ℤ) :
    Measurable (feedbackFutureDirectionMeasure direction) := by
  apply Measure.measurable_measure.mpr
  intro s hs
  simp only [feedbackFutureDirectionMeasure, Measure.sum_apply _ hs]
  apply Measurable.tsum
  intro m
  have hclock : Measurable (fun w : FeedbackCellPath ↦ feedbackCellClock w (m + 1)) :=
    measurable_feedbackCellClock (m + 1)
  have hpoint : Measurable (fun w : FeedbackCellPath ↦
      (feedbackCellClock w (m + 1), (w (m + 1)).2.1)) :=
    hclock.prodMk (measurable_pi_apply _).snd.fst
  have hjump : Measurable (fun w : FeedbackCellPath ↦ feedbackCellJump w m) :=
    ((measurable_pi_apply _).snd.snd).sub ((measurable_pi_apply _).snd.snd)
  have hm : Measurable (fun w : FeedbackCellPath ↦
      if feedbackCellJump w m = direction then
        Measure.dirac (feedbackCellClock w (m + 1), (w (m + 1)).2.1) else 0) :=
    (Measure.measurable_dirac.comp hpoint).ite
      (measurableSet_eq_fun hjump measurable_const) measurable_const
  exact (Measure.measurable_coe hs).comp hm

/-- Both colors of the complete forward marked trajectory. -/
noncomputable def feedbackFuturePointMeasures (w : FeedbackCellPath) :
    Measure MatchingPoint × Measure MatchingPoint :=
  (feedbackFutureDirectionMeasure 1 w, feedbackFutureDirectionMeasure (-1) w)

theorem measurable_feedbackFuturePointMeasures : Measurable feedbackFuturePointMeasures :=
  (measurable_feedbackFutureDirectionMeasure 1).prodMk
    (measurable_feedbackFutureDirectionMeasure (-1))

/-- Restriction of the actual two environment counting measures to strictly positive positions. -/
noncomputable def feedbackPositiveEnvironmentPoints (e : FeedbackEnvironment) :
    Measure MatchingPoint × Measure MatchingPoint :=
  ((LocalConfiguration.countingMeasure e.source).restrict (Ioi (0 : ℝ) ×ˢ univ),
    (LocalConfiguration.countingMeasure e.target).restrict (Ioi (0 : ℝ) ×ˢ univ))

theorem measurable_feedbackPositiveEnvironmentPoints :
    Measurable feedbackPositiveEnvironmentPoints := by
  have hm : Measurable (fun μ : Measure MatchingPoint ↦
      μ.restrict (Ioi (0 : ℝ) ×ˢ univ)) := by
    apply Measure.measurable_measure.mpr
    intro s hs
    simp only [Measure.restrict_apply hs]
    exact Measure.measurable_coe (hs.inter (measurableSet_Ioi.prod MeasurableSet.univ))
  exact (hm.comp (LocalConfiguration.measurable_countingMeasure.comp
    FeedbackEnvironment.measurable_source)).prodMk
      (hm.comp (LocalConfiguration.measurable_countingMeasure.comp
        FeedbackEnvironment.measurable_target))

/-- The actual positive point-process kernel generated by the complete marked path from a current. -/
noncomputable def feedbackFuturePointKernel (lam : ℝ) (hlam0 : 0 < lam)
    (hlam : lam < 1 / 2) : Kernel ℤ (Measure MatchingPoint × Measure MatchingPoint) :=
  (feedbackCurrentTrajectoryKernel lam hlam0 hlam).map feedbackFuturePointMeasures

instance feedbackFuturePointKernel_isMarkov (lam : ℝ) (hlam0 : 0 < lam)
    (hlam : lam < 1 / 2) : IsMarkovKernel (feedbackFuturePointKernel lam hlam0 hlam) := by
  unfold feedbackFuturePointKernel
  exact Kernel.IsMarkovKernel.map _ measurable_feedbackFuturePointMeasures

/-- On the actual roof the bare environment's positive point measures are the measures read
from the complete future, simultaneously for both source and target. -/
theorem feedbackPositiveEnvironmentPoints_eq_roofFuture {lam : ℝ} (hlam0 : 0 < lam)
    (hlam : lam < 1 / 2) :
    (fun p ↦ feedbackPositiveEnvironmentPoints (feedbackReturnEnvironmentObservation lam p).2)
      =ᵐ[feedbackReturnRoofLaw lam hlam0 hlam]
        (fun p ↦ feedbackFuturePointMeasures (feedbackRoofFuture p)) := by
  filter_upwards [ae_countingMeasure_feedbackConcatenatedPoints_positive_eq_future
    lam hlam0 hlam] with p hp
  exact Prod.ext (hp 1) (hp (-1))

/-- The physical stationary environment's current and entire positive marked configurations have
the invariant-current mixture of the actual feedback trajectory kernel. -/
theorem feedbackStationaryEnvironmentLaw_map_current_positivePoints {lam : ℝ}
    (hlam0 : 0 < lam) (hlam : lam < 1 / 2) :
    (feedbackStationaryEnvironmentLaw lam hlam0 hlam).map
      (fun e ↦ (e.path.rootCurrent, feedbackPositiveEnvironmentPoints e)) =
        invariantCurrentMeasure lam ⊗ₘ feedbackFuturePointKernel lam hlam0 hlam := by
  have hObs := FeedbackEnvironment.measurable_rootCurrent.prodMk
    measurable_feedbackPositiveEnvironmentPoints
  rw [← feedbackReturnEnvironmentLaw_map_environment hlam0 hlam,
    Measure.map_map hObs measurable_snd, feedbackReturnEnvironmentLaw,
    Measure.map_map (hObs.comp measurable_snd)
      (measurable_feedbackReturnEnvironmentObservation lam)]
  have heq : (fun p ↦ ((feedbackReturnEnvironmentObservation lam p).2.path.rootCurrent,
      feedbackPositiveEnvironmentPoints (feedbackReturnEnvironmentObservation lam p).2))
      =ᵐ[feedbackReturnRoofLaw lam hlam0 hlam]
      (fun p ↦ (feedbackRoofEnvironmentCurrent lam p,
        feedbackFuturePointMeasures (feedbackRoofFuture p))) := by
    filter_upwards [feedbackPositiveEnvironmentPoints_eq_roofFuture hlam0 hlam] with p hp
    exact Prod.ext rfl hp
  simp only [Function.comp_def]
  rw [Measure.map_congr heq]
  change (feedbackReturnRoofLaw lam hlam0 hlam).map
    ((Prod.map id feedbackFuturePointMeasures) ∘
      (fun p ↦ (feedbackRoofEnvironmentCurrent lam p, feedbackRoofFuture p))) = _
  rw [← Measure.map_map (measurable_id.prodMap measurable_feedbackFuturePointMeasures)
      ((measurable_feedbackRoofEnvironmentCurrent lam).prodMk measurable_feedbackRoofFuture),
    feedbackReturnRoofLaw_map_environmentCurrent_future hlam0 hlam,
    ← Measure.compProd_map measurable_feedbackFuturePointMeasures]
  rfl

/-- The same physical positive marked-process law holds at every deterministic spatial cut. -/
theorem feedbackStationaryEnvironmentLaw_map_cut_current_positivePoints {lam : ℝ}
    (hlam0 : 0 < lam) (hlam : lam < 1 / 2) (t : ℝ) :
    (feedbackStationaryEnvironmentLaw lam hlam0 hlam).map
      (fun e ↦ ((FeedbackEnvironment.reroot t e).path.rootCurrent,
        feedbackPositiveEnvironmentPoints (FeedbackEnvironment.reroot t e))) =
      invariantCurrentMeasure lam ⊗ₘ feedbackFuturePointKernel lam hlam0 hlam := by
  have hObs := FeedbackEnvironment.measurable_rootCurrent.prodMk
    measurable_feedbackPositiveEnvironmentPoints
  have hpres := measurePreserving_feedbackStationaryEnvironmentLaw hlam0 hlam t
  calc
    _ = ((feedbackStationaryEnvironmentLaw lam hlam0 hlam).map
        (fun e : FeedbackEnvironment ↦ t +ᵥ e)).map
        (fun e ↦ (e.path.rootCurrent, feedbackPositiveEnvironmentPoints e)) := by
      rw [Measure.map_map hObs hpres.measurable]
      rfl
    _ = _ := by
      rw [hpres.map_eq]
      exact feedbackStationaryEnvironmentLaw_map_current_positivePoints hlam0 hlam

end OTSelector.Limit
