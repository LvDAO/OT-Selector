import LeanPool.Vlasov.OT.Coupling
import OTSelector.Basic.EmpiricalMeasure
import OTSelector.Basic.Model

/-!
# Empirical transport plans

This file connects the finite assignment model to the coupling API reused from `lean-pool`.
Every permutation produces a probability measure on source-target pairs, and the two marginals are
the empirical source and target laws.
-/

open MeasureTheory

namespace OTSelector

variable {n : ℕ}

namespace FiniteSample

/-- The empirical source law on `(T,U)`. -/
noncomputable def sourceEmpirical [NeZero n] (sample : FiniteSample n) :
    ProbabilityMeasure MarkedHeight :=
  empiricalProbabilityMeasure sample.sourcePoint

/-- The empirical target law on `(S,V)`. -/
noncomputable def targetEmpirical [NeZero n] (sample : FiniteSample n) :
    ProbabilityMeasure MarkedHeight :=
  empiricalProbabilityMeasure sample.targetPoint

/-- The empirical plan generated by an assignment. -/
noncomputable def empiricalPlan [NeZero n] (sample : FiniteSample n) (σ : Assignment n) :
    ProbabilityMeasure PlanPoint :=
  empiricalProbabilityMeasure (sample.matchedPoint σ)

@[simp]
theorem empiricalPlan_toMeasure [NeZero n] (sample : FiniteSample n) (σ : Assignment n) :
    (sample.empiricalPlan σ : Measure PlanPoint) = empiricalMeasure (sample.matchedPoint σ) :=
  rfl

/-- A permutation plan has exactly the two empirical marginals. -/
theorem empiricalPlan_isCoupling [NeZero n] (sample : FiniteSample n) (σ : Assignment n) :
    Vlasov.IsCoupling (sample.empiricalPlan σ : Measure PlanPoint)
      (sample.sourceEmpirical : Measure MarkedHeight)
      (sample.targetEmpirical : Measure MarkedHeight) := by
  constructor
  · rw [empiricalPlan_toMeasure, sourceEmpirical, empiricalProbabilityMeasure_toMeasure,
      map_empiricalMeasure _ Prod.fst measurable_fst]
    congr 1
  · rw [empiricalPlan_toMeasure, targetEmpirical, empiricalProbabilityMeasure_toMeasure,
      map_empiricalMeasure _ Prod.snd measurable_snd]
    simpa [matchedPoint, Function.comp_def] using
      empiricalMeasure_comp_perm sample.targetPoint σ

end FiniteSample

end OTSelector
