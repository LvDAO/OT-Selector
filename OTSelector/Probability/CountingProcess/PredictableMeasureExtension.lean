import Mathlib.MeasureTheory.Measure.Typeclasses.Finite
import Mathlib.Probability.Process.Predictable
import Mathlib.Probability.Process.Stopping

/-!
# Measure extension on the predictable sigma algebra

The predictable sigma algebra is generated by the initial-time rectangles
`{0} x A`, with `A` measurable at time zero, and the left-open rectangles
`(s, infinity) x A`, with `A` measurable at time `s`.  This file records that
these generators form a pi-system and exposes the corresponding finite-measure
extension theorem.

This is the measure-theoretic step used after the feedback calculation has
proved equality on genuine predictable rectangles.  It contains no counting
process or intensity assumption.
-/

open MeasureTheory Set
open scoped ENNReal NNReal

namespace OTSelector.CountingProcess

variable {Omega : Type*} [MeasurableSpace Omega]

/-- The defining generators of the predictable sigma algebra. -/
def predictableGenerator
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega)) :
    Set (Set (NNReal × Omega)) :=
  {s | ∃ A, MeasurableSet[F 0] A ∧ s = ({0} : Set NNReal) ×ˢ A} ∪
    {s | ∃ i A, MeasurableSet[F i] A ∧ s = Ioi i ×ˢ A}

theorem predictable_eq_generateFrom_predictableGenerator
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega)) :
    F.predictable = MeasurableSpace.generateFrom (predictableGenerator F) := by
  rfl

/-- The predictable sigma algebra is contained in the ambient product
sigma algebra. -/
theorem predictable_le_prod
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega)) :
    F.predictable ≤
      (inferInstance : MeasurableSpace NNReal).prod
        (inferInstance : MeasurableSpace Omega) := by
  apply measurableSpace_le_predictable_of_measurableSet
  · intro A hA
    exact (measurableSet_singleton (0 : NNReal)).prod (F.le 0 A hA)
  · intro i A hA
    exact measurableSet_Ioi.prod (F.le i A hA)

/-- A stopping time paired with its sample is measurable into the predictable
sigma algebra after sending the top value to zero.  Later constructions
restrict away the top-valued samples, so that this default has no mass. -/
theorem measurable_stoppingTime_untopD_pair_predictable
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
    {tau : Omega → WithTop NNReal} (htau : IsStoppingTime F tau) :
    Measurable[‹MeasurableSpace Omega›, F.predictable]
      (fun omega => (WithTop.untopD 0 (tau omega), omega)) := by
  have hpair : Measurable
      (fun omega => (WithTop.untopD 0 (tau omega), omega)) :=
    (htau.measurable'.untopD 0).prodMk measurable_id
  exact hpair.mono le_rfl (predictable_le_prod F)

/-- The defining predictable rectangles are closed under every nonempty
binary intersection. -/
theorem isPiSystem_predictableGenerator
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega)) :
    IsPiSystem (predictableGenerator F) := by
  intro s hs t ht hst
  rcases hs with hs | hs
  · rcases hs with ⟨A, hA, rfl⟩
    rcases ht with ht | ht
    · rcases ht with ⟨B, hB, rfl⟩
      left
      refine ⟨A ∩ B, hA.inter hB, ?_⟩
      ext z
      simp only [mem_inter_iff, mem_prod, mem_singleton_iff]
      aesop
    · rcases ht with ⟨j, B, hB, rfl⟩
      exfalso
      rcases hst with ⟨z, hz⟩
      have hz0 : z.1 = 0 := hz.1.1
      have hzj : j < z.1 := hz.2.1
      rw [hz0] at hzj
      exact (not_lt_of_ge bot_le) hzj
  · rcases hs with ⟨i, A, hA, rfl⟩
    rcases ht with ht | ht
    · rcases ht with ⟨B, hB, rfl⟩
      exfalso
      rcases hst with ⟨z, hz⟩
      have hzi : i < z.1 := hz.1.1
      have hz0 : z.1 = 0 := hz.2.1
      rw [hz0] at hzi
      exact (not_lt_of_ge bot_le) hzi
    · rcases ht with ⟨j, B, hB, rfl⟩
      right
      rcases le_total i j with hij | hji
      · refine ⟨j, A ∩ B, (F.mono hij A hA).inter hB, ?_⟩
        ext z
        simp only [mem_inter_iff, mem_prod, mem_Ioi]
        constructor
        · rintro ⟨⟨hi, hza⟩, hj, hzb⟩
          exact ⟨hj, hza, hzb⟩
        · rintro ⟨hj, hza, hzb⟩
          exact ⟨⟨hij.trans_lt hj, hza⟩, hj, hzb⟩
      · refine ⟨i, A ∩ B, hA.inter (F.mono hji B hB), ?_⟩
        ext z
        simp only [mem_inter_iff, mem_prod, mem_Ioi]
        constructor
        · rintro ⟨⟨hi, hza⟩, hj, hzb⟩
          exact ⟨hi, hza, hzb⟩
        · rintro ⟨hi, hza, hzb⟩
          exact ⟨⟨hi, hza⟩, hji.trans_lt hi, hzb⟩

/-- Two finite measures on the predictable sigma algebra agree once they
agree on the defining rectangles and on the whole space. -/
theorem measure_eq_on_predictable_of_eq_generator
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
    {mu nu : @Measure (NNReal × Omega) F.predictable}
    [IsFiniteMeasure mu]
    (hrect : ∀ s, s ∈ predictableGenerator F → mu s = nu s)
    (huniv : mu univ = nu univ) :
    mu = nu := by
  exact ext_of_generate_finite
    (predictableGenerator F)
    (predictable_eq_generateFrom_predictableGenerator F)
    (isPiSystem_predictableGenerator F) hrect huniv

end OTSelector.CountingProcess
