import OTSelector.Probability.CountingProcess.FiniteEventPredictableMeasure

/-!
# Finite-horizon extension on the predictable sigma algebra

This file isolates the elementary measure-theoretic extension used by the finite
event construction.  The predictable sigma algebra is generated by the atoms
`{0} × A` and the rays `Ioi i × A`; after restricting both measures to
`(0,T] × Ω`, the former have zero mass and the latter are exactly the genuine
predictable rectangles `(i,T] × A` when `i<T`.

No intensity, martingale, or certificate interface is introduced here.
-/

open MeasureTheory Set
open scoped ENNReal NNReal BigOperators

namespace OTSelector.CountingProcess

set_option linter.style.haveILetI false

variable {Omega : Type*} [MeasurableSpace Omega]

/-- The finite time-space horizon used by the extension theorem. -/
def finiteHorizon (T : NNReal) : Set (NNReal × Omega) :=
  Ioc (0 : NNReal) T ×ˢ (univ : Set Omega)

theorem measurableSet_finiteHorizon
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
  (T : NNReal) :
  MeasurableSet[F.predictable] (finiteHorizon (Omega := Omega) T) := by
  exact measurableSet_predictable_Ioc_prod 0 T MeasurableSet.univ

omit [MeasurableSpace Omega] in
private theorem finiteHorizon_inter_singleton
    (T : NNReal) (A : Set Omega) :
    (({0} : Set NNReal) ×ˢ A) ∩ finiteHorizon (Omega := Omega) T = ∅ := by
  ext z
  simp only [mem_inter_iff, mem_prod, mem_singleton_iff,
    mem_empty_iff_false, iff_false]
  rintro ⟨⟨hz0, -⟩, ⟨hzT0, -, -⟩⟩
  simp [hz0] at hzT0

omit [MeasurableSpace Omega] in
private theorem finiteHorizon_inter_Ioi_lt
    (T i : NNReal) (_hiT : i < T) (A : Set Omega) :
    (Ioi i ×ˢ A) ∩ finiteHorizon (Omega := Omega) T = Ioc i T ×ˢ A := by
  ext z
  simp only [mem_inter_iff, mem_prod, mem_Ioi, mem_Ioc]
  constructor
  · rintro ⟨⟨hiz, hzA⟩, hzt⟩
    exact ⟨⟨hiz, hzt.1.2⟩, hzA⟩
  · rintro ⟨⟨hiz, hzT⟩, hzA⟩
    exact ⟨⟨hiz, hzA⟩, ⟨⟨lt_of_le_of_lt bot_le hiz, hzT⟩, trivial⟩⟩

omit [MeasurableSpace Omega] in
private theorem finiteHorizon_inter_Ioi_ge
    (T i : NNReal) (hTi : T ≤ i) (A : Set Omega) :
    (Ioi i ×ˢ A) ∩ finiteHorizon (Omega := Omega) T = ∅ := by
  ext z
  simp only [mem_inter_iff, mem_prod, mem_Ioi,
    mem_empty_iff_false, iff_false]
  rintro ⟨⟨hiz, -⟩, hzt⟩
  exact (not_lt_of_ge hTi) (hiz.trans_le hzt.1.2)

/-- Equality of two finite predictable measures follows from equality on
genuine finite-horizon rectangles, provided both measures are carried by the
open-left horizon `(0,T] × Ω`.

The support assumptions are stated as restriction equalities.  This is the
form needed by the later jump and density constructions and also avoids any
unstated measurable-support convention.
-/
theorem measure_eq_on_predictable_of_eq_finiteHorizon_rectangles
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
    {mu nu : @Measure (NNReal × Omega) F.predictable}
    [IsFiniteMeasure mu]
    (T : NNReal) (hT : 0 < T)
    (hmu_support : mu = mu.restrict (finiteHorizon (Omega := Omega) T))
    (hnu_support : nu = nu.restrict (finiteHorizon (Omega := Omega) T))
    (hrect : ∀ s : NNReal, s < T → ∀ A : Set Omega,
      MeasurableSet[F s] A →
        mu (Ioc s T ×ˢ A) = nu (Ioc s T ×ˢ A)) :
    mu = nu := by
  apply measure_eq_on_predictable_of_eq_generator F
  · intro S hS
    rcases hS with hS | hS
    · rcases hS with ⟨A, hA, rfl⟩
      have hmeas : MeasurableSet[F.predictable] (({0} : Set NNReal) ×ˢ A) :=
        measurableSet_predictable_singleton_bot_prod hA
      rw [hmu_support, Measure.restrict_apply hmeas,
        hnu_support, Measure.restrict_apply hmeas,
        finiteHorizon_inter_singleton]
      simp
    · rcases hS with ⟨i, A, hA, rfl⟩
      have hmeas : MeasurableSet[F.predictable] (Ioi i ×ˢ A) :=
        measurableSet_predictable_Ioi_prod hA
      by_cases hiT : i < T
      · rw [hmu_support, Measure.restrict_apply hmeas,
          hnu_support, Measure.restrict_apply hmeas,
          finiteHorizon_inter_Ioi_lt T i hiT A]
        exact hrect i hiT A hA
      · have hTi : T ≤ i := le_of_not_gt hiT
        rw [hmu_support, Measure.restrict_apply hmeas,
          hnu_support, Measure.restrict_apply hmeas,
          finiteHorizon_inter_Ioi_ge T i hTi A]
        simp
  · rw [hmu_support, hnu_support, Measure.restrict_apply_univ,
      Measure.restrict_apply_univ]
    simpa [finiteHorizon] using hrect 0 hT univ MeasurableSet.univ

/-- The density measure already used for a finite horizon is supported on that
horizon. -/
theorem finiteHorizonIntensityMeasure_eq_restrict
    (mu : Measure Omega)
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
    (Lambda : NNReal → Omega → Real) (T : NNReal) :
    finiteHorizonIntensityMeasure mu F Lambda T =
      (finiteHorizonIntensityMeasure mu F Lambda T).restrict
        (finiteHorizon (Omega := Omega) T) := by
  rw [finiteHorizonIntensityMeasure,
    MeasureTheory.restrict_withDensity (measurableSet_finiteHorizon F T),
    Measure.restrict_restrict (measurableSet_finiteHorizon F T)]
  simp [finiteHorizon]

/-- A finite event measure is supported on the same horizon when finite event
times are strictly positive (apart from the top value, which is removed by
the defining restriction `xi i ≤ T`). -/
theorem finiteEventJumpMeasure_eq_restrict_finiteHorizon
    {m : Nat}
    (mu : Measure Omega)
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
    (xi : Fin m → Omega → WithTop NNReal)
    (hxi : ∀ i, IsStoppingTime F (xi i))
    (T : NNReal)
    (hpos : ∀ i ω, xi i ω = ⊤ ∨ (0 : WithTop NNReal) < xi i ω) :
    finiteEventJumpMeasure mu F xi hxi T =
      (finiteEventJumpMeasure mu F xi hxi T).restrict
        (finiteHorizon (Omega := Omega) T) := by
  have hR : MeasurableSet[F.predictable]
      (finiteHorizon (Omega := Omega) T) := measurableSet_finiteHorizon F T
  have hsummand : ∀ i : Fin m,
      (@Measure.map Omega (NNReal × Omega)
        (inferInstance : MeasurableSpace Omega) F.predictable
        (fun omega => (WithTop.untopD 0 (xi i omega), omega))
        (mu.restrict {omega | xi i omega ≤ (T : WithTop NNReal)})).restrict
          (finiteHorizon (Omega := Omega) T) =
      @Measure.map Omega (NNReal × Omega)
        (inferInstance : MeasurableSpace Omega) F.predictable
        (fun omega => (WithTop.untopD 0 (xi i omega), omega))
        (mu.restrict {omega | xi i omega ≤ (T : WithTop NNReal)}) := by
    intro i
    letI : MeasurableSpace (NNReal × Omega) := F.predictable
    let f : Omega → NNReal × Omega :=
      fun omega => (WithTop.untopD 0 (xi i omega), omega)
    let E : Set Omega := {omega | xi i omega ≤ (T : WithTop NNReal)}
    have hE : MeasurableSet E := by
      exact (F.le T) _ ((hxi i).measurableSet_le T)
    have hf : Measurable[‹MeasurableSpace Omega›, F.predictable] f := by
      exact measurable_stoppingTime_untopD_pair_predictable F (hxi i)
    have hsub : E ⊆ f ⁻¹' (finiteHorizon (Omega := Omega) T) := by
      intro ω hω
      have hne : xi i ω ≠ ⊤ := by
        intro htop
        change xi i ω ≤ (T : WithTop NNReal) at hω
        rw [htop] at hω
        exact (WithTop.not_top_le_coe T) hω
      obtain ⟨r, hr⟩ := WithTop.ne_top_iff_exists.mp hne
      have hpos' : (0 : WithTop NNReal) < xi i ω :=
        (hpos i ω).resolve_left hne
      have hr0 : 0 < r := by
        apply WithTop.coe_pos.mp
        rw [hr]
        exact hpos'
      have hrT : r ≤ T := by
        apply WithTop.coe_le_coe.mp
        rw [hr]
        exact hω
      change f ω ∈ finiteHorizon (Omega := Omega) T
      change f ω ∈ Ioc (0 : NNReal) T ×ˢ (univ : Set Omega)
      refine ⟨?_, Set.mem_univ _⟩
      change WithTop.untopD 0 (xi i ω) ∈ Ioc (0 : NNReal) T
      rw [← hr, WithTop.untopD_coe]
      exact ⟨hr0, hrT⟩
    have hae : ∀ᵐ ω ∂(mu.restrict E),
        ω ∈ f ⁻¹' finiteHorizon (Omega := Omega) T :=
      (ae_restrict_mem hE).mono (fun ω hω => hsub hω)
    have hrestrict : (mu.restrict E).restrict
        (f ⁻¹' finiteHorizon (Omega := Omega) T) = mu.restrict E :=
      Measure.restrict_eq_self_of_ae_mem hae
    have hmap :
        (@Measure.map Omega (NNReal × Omega)
          (inferInstance : MeasurableSpace Omega) F.predictable
          (fun omega => (WithTop.untopD 0 (xi i omega), omega))
          (mu.restrict {omega | xi i omega ≤ (T : WithTop NNReal)})).restrict
            (finiteHorizon (Omega := Omega) T) =
        @Measure.map Omega (NNReal × Omega)
          (inferInstance : MeasurableSpace Omega) F.predictable
          (fun omega => (WithTop.untopD 0 (xi i omega), omega))
          (mu.restrict {omega | xi i omega ≤ (T : WithTop NNReal)}) := by
      rw [Measure.restrict_map hf hR]
      simpa [f, E] using congrArg
        (fun v : Measure Omega => @Measure.map Omega (NNReal × Omega)
          (inferInstance : MeasurableSpace Omega) F.predictable
          (fun omega => (WithTop.untopD 0 (xi i omega), omega)) v) hrestrict
    exact hmap
  let ν : Fin m → @Measure (NNReal × Omega) F.predictable := fun i =>
    @Measure.map Omega (NNReal × Omega)
      (inferInstance : MeasurableSpace Omega) F.predictable
      (fun omega => (WithTop.untopD 0 (xi i omega), omega))
      (mu.restrict {omega | xi i omega ≤ (T : WithTop NNReal)})
  change (∑ i : Fin m, ν i) = (∑ i : Fin m, ν i).restrict
    (finiteHorizon (Omega := Omega) T)
  have hfin : ∀ s : Finset (Fin m),
      (s.sum ν).restrict (finiteHorizon (Omega := Omega) T) =
        s.sum (fun i => (ν i).restrict (finiteHorizon (Omega := Omega) T)) := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi, Measure.restrict_add, ih, Finset.sum_insert hi]
  rw [hfin Finset.univ]
  apply Finset.sum_congr rfl
  intro i hi
  exact (hsummand i).symm

end OTSelector.CountingProcess
