import OTSelector.Probability.UsualAugmentation
import Mathlib.MeasureTheory.Integral.Bochner.Set

/-!
# Reduction of ambient-null augmentation events

The ambient-null augmentation is generated by the original filtration events and
ambient-measurable null events.  Consequently each event measurable in one
augmented sigma-algebra has an original-filtration representative modulo the
ambient measure.  The proof below follows the generators explicitly; it does
not use a completion or an additional assumption.
-/

open MeasureTheory Set
open scoped NNReal Topology

namespace OTSelector

variable {Ω ι : Type*} {m : MeasurableSpace Ω}

/-- Every event in the ambient-null augmentation has an event from the original
filtration which agrees with it almost everywhere. -/
theorem exists_original_measurableSet_ae_eq_of_ambientNullAugmentation
    [Preorder ι] (ℱ : Filtration ι m) (μ : Measure Ω) {i : ι} {B : Set Ω}
    (hB : MeasurableSet[ambientNullAugmentation ℱ μ i] B) :
    ∃ A : Set Ω, MeasurableSet[ℱ i] A ∧ B =ᵐ[μ] A := by
  change MeasurableSet[ambientNullAugmentationSeq ℱ μ i] B at hB
  induction B, hB using MeasurableSpace.generateFrom_induction with
  | hC s hs _ =>
      rcases hs with hs | hs
      · exact ⟨s, hs, ae_eq_refl s⟩
      · exact ⟨(∅ : Set Ω), @MeasurableSet.empty Ω (ℱ i), ae_eq_empty.mpr hs.2⟩
  | empty =>
      exact ⟨(∅ : Set Ω), @MeasurableSet.empty Ω (ℱ i), ae_eq_refl (∅ : Set Ω)⟩
  | compl s _ hs =>
      rcases hs with ⟨A, hA, hEq⟩
      exact ⟨Aᶜ, hA.compl, ae_eq_set_compl_compl.mpr hEq⟩
  | iUnion s _ hs =>
      refine ⟨⋃ n, Classical.choose (hs n), MeasurableSet.iUnion ?_, ?_⟩
      · intro n
        exact (Classical.choose_spec (hs n)).1
      · exact Filter.EventuallyEq.countable_iUnion fun n ↦ (Classical.choose_spec (hs n)).2

/-- Replacing an augmented measurable set by its original-filtration
representative does not change any Bochner set integral. -/
theorem setIntegral_eq_of_ambientNullAugmentation_ae_eq
    [Preorder ι] (ℱ : Filtration ι m) (μ : Measure Ω) {i : ι} {B : Set Ω}
    (hB : MeasurableSet[ambientNullAugmentation ℱ μ i] B)
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : Ω → E) :
    ∃ A : Set Ω, MeasurableSet[ℱ i] A ∧
      (∫ x in B, f x ∂μ) = ∫ x in A, f x ∂μ := by
  obtain ⟨A, hA, hEq⟩ :=
    exists_original_measurableSet_ae_eq_of_ambientNullAugmentation ℱ μ hB
  exact ⟨A, hA, setIntegral_congr_set hEq⟩

/-- A right-continuous event at time `t` has an original-filtration
representative at every strictly later time.  The representative is allowed
to depend on the later time; no representative at `t` itself is asserted. -/
theorem exists_original_measurableSet_ae_eq_of_usualAugmentation_nnreal
    (ℱ : Filtration ℝ≥0 m) (μ : Measure Ω) {t : ℝ≥0} {B : Set Ω}
    (hB : MeasurableSet[usualAugmentation ℱ μ t] B) :
    ∀ u : ℝ≥0, t < u →
      ∃ A : Set Ω, MeasurableSet[ℱ u] A ∧ B =ᵐ[μ] A := by
  intro u htu
  have hB' : MeasurableSet[⨅ j > t, ambientNullAugmentation ℱ μ j] B := by
    change MeasurableSet[(Filtration.rightCont (ambientNullAugmentation ℱ μ)) t] B at hB
    rw [Filtration.rightCont_eq (ambientNullAugmentation ℱ μ) t] at hB
    exact hB
  have hle : (⨅ j > t, ambientNullAugmentation ℱ μ j) ≤
      ambientNullAugmentation ℱ μ u := iInf₂_le u htu
  have hB'' : MeasurableSet[ambientNullAugmentation ℱ μ u] B := hle B hB'
  exact exists_original_measurableSet_ae_eq_of_ambientNullAugmentation
    ℱ μ hB''

end OTSelector
